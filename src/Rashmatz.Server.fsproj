<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded SQL files (schema + complex queries co-located in slices) -->
    <EmbeddedResource Include="shared/schema.sql" LogicalName="shared/schema.sql" />
    <EmbeddedResource Include="pages/relocate/recent_relocations.sql" LogicalName="pages/relocate/recent_relocations.sql" />
    <EmbeddedResource Include="pages/transfers-new-items/dest_balances.sql" LogicalName="pages/transfers-new-items/dest_balances.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared Core & Infrastructure -->
    <Compile Include="shared/Errors.fs" />
    <Compile Include="shared/Domain.fs" />
    <Compile Include="shared/Sql.fs" />
    <Compile Include="shared/Database.fs" />
    <Compile Include="shared/Auth.fs" />
    <Compile Include="shared/Navbar.fs" />
    <Compile Include="shared/Http.fs" />

    <!-- Vertical Slices (co-located with future TS/HTML client files) -->
    <Compile Include="pages/login/login.server.fs" />
    <Compile Include="pages/my-custody/my-custody.server.fs" />
    <Compile Include="pages/relocate/relocate.server.fs" />
    <Compile Include="pages/transfers-new-template/transfers-new-template.server.fs" />
    <Compile Include="pages/transfers-new-parties/transfers-new-parties.server.fs" />
    <Compile Include="pages/transfers-new-items/TransfersNewItems.Domain.fs" />
    <Compile Include="pages/transfers-new-items/TransfersNewItems.Db.fs" />
    <Compile Include="pages/transfers-new-items/TransfersNewItems.Endpoints.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="3.0.0" />
    <PackageReference Include="Oxpecker.OpenApi" Version="3.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="Donald" Version="10.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
