{
  // ============================================================================
  // Rashmatz Application Configuration
  // ============================================================================
  //
  // HOW TO GET GOOGLE AUTH ClientId AND ClientSecret:
  //
  // 1. Open Google Cloud Console: https://console.cloud.google.com/
  //    Create a new project (or select an existing one).
  //
  // 2. Configure the OAuth Consent Screen:
  //    - In the left menu, go to "Google Auth Platform" -> "Branding" & "Audience"
  //      (or "APIs & Services" -> "OAuth consent screen").
  //    - Enter an App name (e.g., "Rashmatz"), User support email, and Developer
  //      contact email.
  //    - Choose Audience: "External" (for standard Gmail accounts) or "Internal"
  //      (if restricted to a Google Workspace organization).
  //    - Under "Data Access" / "Scopes", ensure standard sign-in scopes are
  //      included: openid, .../auth/userinfo.email, .../auth/userinfo.profile.
  //    - If Audience is "External" and Publishing status is "Testing", go to
  //      "Audience" -> "Test users" and add the Google email addresses you will
  //      sign in with during development.
  //
  // 3. Create OAuth 2.0 Client Credentials:
  //    - Go to "Google Auth Platform" -> "Clients" -> "+ Create Client"
  //      (or "APIs & Services" -> "Credentials" -> "+ Create Credentials" -> "OAuth client ID").
  //    - Application type: "Web application".
  //    - Name: e.g. "Rashmatz Web Client".
  //    - Authorized JavaScript origins:
  //        * Local dev:  http://localhost:5000
  //        * Production: https://app.oryan.top  (your frontend origin)
  //    - Authorized redirect URIs (CRITICAL - must match Auth.fs CallbackPath "/signin-google"):
  //        * Local dev:  http://localhost:5000/signin-google
  //        * Production: https://api.oryan.top/signin-google
  //
  // 4. Copy the generated "Client ID" and "Client secret":
  //    - Paste them into Authentication -> Google -> ClientId / ClientSecret below.
  //    - SECURITY NOTE: Do NOT commit real secrets to git! For local dev, prefer:
  //        dotnet user-secrets init --project src/Rashmatz.fsproj
  //        dotnet user-secrets set "Authentication:Google:ClientId" "<your-client-id>" --project src/Rashmatz.fsproj
  //        dotnet user-secrets set "Authentication:Google:ClientSecret" "<your-client-secret>" --project src/Rashmatz.fsproj
  //      Or set environment variables:
  //        Authentication__Google__ClientId=...
  //        Authentication__Google__ClientSecret=...
  // ============================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      // Required at startup (read by Auth.fs): replace empty strings via user-secrets,
      // environment variables, or local-only config before starting the server.
      "ClientId": "",
      "ClientSecret": ""
    },
    // Optional post-login / post-logout base URL for frontend redirects (defaults to "/").
    "FrontendBaseUrl": "",
    // Optional development whitelist entries loaded by MockDb on startup.
    // Add your Google email here with Role "Admin" or "Member" to test login locally.
    "SeedWhitelist": [
      // {
      //   "Email": "your.email@gmail.com",
      //   "FullName": "Your Name",
      //   "OrgSlug": "rashmatz-hq",
      //   "Role": "Admin",
      //   "IsSuperAdmin": false
      // }
    ]
  }
}
